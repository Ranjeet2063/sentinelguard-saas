{
  "name": "SentinelGuard-Security-Auditor",
  "url": "https://github.com/marketplace",
  "hook_attributes": {
    "url": "https://api.yourdomain.com/api/github/webhook",
    "active": true
  },
  "redirect_url": "https://api.yourdomain.com/setup/callback",
  "callback_urls": [
    "https://api.yourdomain.com/auth/callback"
  ],
  "public": true,
  "default_permissions": {
    "pull_requests": "write",
    "issues": "write",
    "checks": "write",
    "contents": "read",
    "metadata": "read"
  },
  "default_events": [
    "pull_request",
    "marketplace_purchase"
  ],
  "description": "Autonomous security invariant scanner and automated code review auditor for Soroban smart contracts, Web3 protocols, and critical codebases."
}
